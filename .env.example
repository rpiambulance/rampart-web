# Auth.js
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_KEYCLOAK_ID=rampart-admin
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://keycloak:8080/realms/rampart
AUTH_URL=http://localhost:3002

# Rampart API base URL (server-side)
RAMPART_API_URL=http://localhost:3001

# Local-only: dashboard username/password form (server-side Keycloak
# password grant; no browser redirect). Never enable in production.
# AUTH_DEV_LOGIN=true

# Coolify deploy (used by scripts/deploy.sh, not the app)
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=
# COOLIFY_APP_UUID=
# REGISTRY_IMAGE=registry.example.com/rpiambulance/rampart-admin
